# Copy this file to `.env` and fill in the values. NEVER commit the real .env.
#
# Gemini API key — keep it ONLY here (and in the host's environment variables on
# deploy). It must never appear in the mobile app or in client-distributed files.
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use. Default has a free tier. Change it here if the free-tier
# availability changes, without touching the code. As of late 2026, the
# "flash-lite" models (e.g. gemini-3.5-flash-lite) offer a generous free tier
# (~500 requests/day). Fuller "flash" models (e.g. gemini-3.8-flash) have
# higher quality but a smaller free tier (~20/day).
GEMINI_MODEL=gemini-3.5-flash-lite

# HTTP port for local development.
PORT=3000

# Max questions allowed per generation request (safety limit).
MAX_QUESTIONS_PER_REQUEST=10
